# 이 파일을 .env 로 복사해서 쓴다.  cp .env.example .env
#
# --name     이 무전기 이름 (두 대가 서로 달라야 한다)
# --peer     상대 주소 host:port (Tailscale 이름이나 100.x IP 를 권한다)
# --in-dev   마이크,  --out-dev 스피커  (setup_pi.sh 가 만드는 walkie_in / walkie_out)
# --camera   파이 카메라면 picam, USB 웹캠이면 0, 카메라가 없으면 이 옵션을 뺀다
WALKIE_ARGS=--name PI --peer 100.89.50.50:7700 --port 7700 --http 8080 --in-dev walkie_in --out-dev walkie_out --camera picam
